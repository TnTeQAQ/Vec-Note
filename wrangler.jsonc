{
	"name": "vec-note",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-04",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vec-note",
			"migrations_dir": "migrations"
		},
		{
			"binding": "vec_note",
			"database_name": "vec-note",
			"database_id": "3841b7ca-a0e2-4ca8-b669-8579576da32a"
		}
	]
}